# Copy to .env and fill in your real key, or leave it out and store the key in the
# system keychain from the app's Settings dialog (the keychain wins when both are set).
OPENAI_API_KEY=your_kimi_api_key_here
OPENAI_BASE_URL=https://api.moonshot.ai/v1
OPENAI_MODEL=kimi-k2.6
# DeepSeek works the same way:
# OPENAI_API_KEY=your_deepseek_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-flash
# 1 = let the model reason before replying (slower, longer replies)
CHAT_THINKING=0
# CHAT_TOOLS=0
# Opt-in push-to-talk; not yet wired into the window. Requires a transcription model.
# Uses the chat base URL and API key; an empty model disables voice input.
# VOICE_INPUT=0
# TRANSCRIPTION_MODEL=
# Wake word is not wired into the window yet. Requires the flag, phrases and model directory.
# WAKE_WORD=0
# WAKE_WORD_PHRASES=hey whale
# Path to an unpacked Vosk model directory; empty disables the wake word.
# WAKE_WORD_MODEL_DIR=C:/models/vosk-model
# Opt in to idle chat, time-of-day greetings, and spoken due reminders.
PROACTIVE_CHAT=0
# Opt in to foreground-app streak comments; requires PROACTIVE_CHAT=1.
# Tracks only the app name locally; sends a short app-name/duration summary to the LLM.
ACTIVE_APP_MONITOR=0
# Her feelings (joy, anger, hurt, jealousy, longing) carry over between replies and fade
# toward calm (half-life in minutes); 0 turns it off. Stored in state.json in the user data dir.
# COMPANION_STATE=1
# MOOD_HALF_LIFE_MINUTES=120
# Emotional turns (praise, jealousy, apologies, the user being upset...) are judged with one
# extra small LLM request; small talk never triggers it. 0 keeps feelings from reply tags only.
# EMOTION_APPRAISAL=1
# Reply like texting: a few short messages with "typing…" pauses, a bit later when she is
# busy or asleep. 0 restores one streaming bubble.
# REPLY_PACING=1
# She writes a short diary entry for each day you talked (the day after) and remembers what
# she said about herself (likes, promises). Stored in diary.json and self_memory.json.
# COMPANION_DIARY=1
# Her daily routine (edit it in Persona…): asleep she starts nothing but reminders and
# answers sleepily; late at night she gets drowsy; in class she keeps replies short.
# DAILY_SCHEDULE=1
EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
EDGE_TTS_VOICE_ZH=zh-CN-XiaoyiNeural
# Offsets for the Chinese voice only, to sound younger and livelier; +0Hz / +0% is neutral.
TTS_PITCH=+10Hz
TTS_RATE=+6%
EDGE_TTS_VOICE_EN=en-US-AriaNeural
MEMORY_ENABLED=1
# Compare candidates with stored memories; 0 restores exact-text deduplication only.
# MEMORY_CONSOLIDATION=1
# Prefer lexical matches to the current message; 0 restores newest-first recall.
# MEMORY_RELEVANT_RECALL=1
# Opt-in semantic recall sends stored memory text and the user message to /embeddings.
# Uses the same base URL and API key as chat, with a 30-second socket timeout.
# MEMORY_SEMANTIC_RECALL=0
# Empty model disables semantic recall even when the flag is on; set a supported model.
# EMBEDDING_MODEL=
MEMORY_LIMIT=24
# Optional: store memory and logs somewhere other than the platform user data directory
# COMPANION_DATA_DIR=~/ai-companion-data
