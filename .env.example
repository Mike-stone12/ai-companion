# Copy to .env and fill in your real key
OPENAI_API_KEY=your_kimi_api_key_here
OPENAI_BASE_URL=https://api.moonshot.ai/v1
OPENAI_MODEL=kimi-k2.6
# DeepSeek works the same way:
# OPENAI_API_KEY=your_deepseek_api_key_here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-flash
# 1 = let the model reason before replying (slower, longer replies)
CHAT_THINKING=0
# CHAT_TOOLS=0
# Opt-in push-to-talk; not yet wired into the window. Requires a transcription model.
# Uses the chat base URL and API key; an empty model disables voice input.
# VOICE_INPUT=0
# TRANSCRIPTION_MODEL=
# Opt in to idle chat, time-of-day greetings, and spoken due reminders.
PROACTIVE_CHAT=0
# Opt in to foreground-app streak comments; requires PROACTIVE_CHAT=1.
# Tracks only the app name locally; sends a short app-name/duration summary to the LLM.
ACTIVE_APP_MONITOR=0
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_EN=en-US-AriaNeural
MEMORY_ENABLED=1
# Compare candidates with stored memories; 0 restores exact-text deduplication only.
# MEMORY_CONSOLIDATION=1
# Prefer lexical matches to the current message; 0 restores newest-first recall.
# MEMORY_RELEVANT_RECALL=1
# Opt-in semantic recall sends stored memory text and the user message to /embeddings.
# Uses the same base URL and API key as chat, with a 30-second socket timeout.
# MEMORY_SEMANTIC_RECALL=0
# Empty model disables semantic recall even when the flag is on; set a supported model.
# EMBEDDING_MODEL=
MEMORY_LIMIT=24
# Optional: store memory and logs somewhere other than the platform user data directory
# COMPANION_DATA_DIR=~/ai-companion-data
